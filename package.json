{
  "name": "class-score-app",
  "version": "1.0.0",
  "private": true,
  "description": "A short-term privacy-conscious class peer scoring app",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "cf:dev": "wrangler dev",
    "cf:migrate:local": "wrangler d1 migrations apply class-score-db --local",
    "cf:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
